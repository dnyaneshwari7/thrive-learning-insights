# Northbrook Insights AI Assistant - Environment Configuration
# Copy this file to .env and insert your Gemini API Key.
# Obtain a free key at: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name (e.g. gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash
